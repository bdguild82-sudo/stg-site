<style>
*{margin:0;padding:0;box-sizing:border-box}

body{
    font-family:'Orbitron',sans-serif;
    min-height:100vh;
    background:linear-gradient(-45deg,#020824,#04133a,#0a2a66,#04133a);
    background-size:400% 400%;
    animation:gradientMove 14s ease infinite;
    color:#e6f0ff;
}

@keyframes gradientMove{
    0%{background-position:0% 50%}
    50%{background-position:100% 50%}
    100%{background-position:0% 50%}
}

.container{
    max-width:900px;
    margin:auto;
    padding:60px 20px;
}

h1{
    text-align:center;
    font-size:90px;
    margin-bottom:50px;
    text-shadow:0 0 30px rgba(120,180,255,.7);
}
.section{margin-bottom:60px}

.section h2{
    font-size:32px;
    margin-bottom:20px;
    color:#9cc9ff;
    text-shadow:0 0 15px rgba(120,180,255,.6);
}

.list{
    background:rgba(5,15,40,.7);
    border-radius:16px;
    padding:20px;
    box-shadow:0 0 30px rgba(0,0,0,.4);
}

/* ===== ITEMS ===== */
.item{
    position:relative;
    padding:10px 0;
    border-bottom:1px solid rgba(255,255,255,.08);
    transition:.25s ease;
    overflow:hidden;
}
.item:hover{
    transform:scale(1.06) translateX(6px);
    text-shadow:0 0 12px rgba(150,200,255,.9);
}
.item:last-child{border-bottom:none}
.rank1{color:gold}
.rank2{color:silver}
.rank3{color:#cd7f32}
.slash::after{
    content:"";
    position:absolute;
    top:-150%;
    left:-150%;
    width:300%;
    height:300%;
    background:linear-gradient(
        135deg,
        transparent 46%,
        rgba(255,255,255,.85) 50%,
        transparent 54%
    );
    animation:slashLoop 6.5s ease-in-out infinite;
    pointer-events:none;
}

@keyframes slashLoop{
    0%{transform:translate(-130%,-130%);opacity:0}
    15%{opacity:1}
    60%{transform:translate(130%,130%);opacity:1}
    100%{transform:translate(130%,130%);opacity:0}
}
.credit{
    margin-top:80px;
    text-align:center;
    font-size:18px;
    font-weight:900;
    color:white;
    animation:floatGlow 3s ease-in-out infinite;
    text-shadow:0 0 15px rgba(255,255,255,.7);
}
@keyframes floatGlow{
    0%{transform:translateY(0);opacity:.8}
    50%{transform:translateY(-6px);opacity:1}
    100%{transform:translateY(0);opacity:.8}
}
</style>
</head>

